  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5) Credible Interval Decisions with Smart Repurposing\n",
    "\n",
    "Phase-dependent decision thresholds - the bar rises as capital commitment increases:\n",
    "\n",
    "| Phase | Kill (CI upper <) | Go (CI lower >) |\n",
    "|-------|-------------------|-----------------|\n",
    "| Phase I | 0.05 | 0.15 |\n",
    "| Phase II | 0.10 | 0.25 |\n",
    "| Phase III | 0.15 | 0.40 |\n",
    "\n",
    "- **Go** if CI lower bound > phase-specific go threshold\n",
    "- **Kill** if CI upper bound < phase-specific kill threshold AND no high-similarity repurpose candidate exists\n",
    "- **Repurpose** if below kill threshold BUT a correlated alternative indication has similarity > 0.5\n",
    "- **Repurpose** for everything in between (uncertain - explore alternatives)\n",
    "\n",
    "Repurpose PoTS is computed via Bayesian transfer: `PoTS_new = PoTS_original * similarity_score`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Asset     Phase Current Indication  PoTS (current)         90% CI  Kill thresh  Go thresh  Decision Suggested Repurpose  Repurpose PoTS                                             Reason\n",
      "Asset A  Phase II                SLE           0.267 [0.104, 0.466]         0.10       0.25 Repurpose     Lupus Nephritis           0.200    Shared JAK-STAT pathway with renal inflammation\n",
      "Asset B  Phase II    Lupus Nephritis           0.375 [0.191, 0.577]         0.10       0.25 Repurpose                 SLE           0.281 Shared JAK-STAT pathway with systemic autoimmunity\n",
      "Asset C   Phase I    Type 2 Diabetes           0.143 [0.028, 0.316]         0.05       0.15 Repurpose     Obesity (GLP-1)           0.100                      Direct GLP-1 receptor agonism\n",
      "Asset D Phase III              NAFLD           0.333 [0.153, 0.540]         0.15       0.40 Repurpose       NASH Fibrosis           0.267   Same hepatic lipid target with fibrotic endpoint\n",
      "Asset E   Phase I    Rare Haem (PNH)           0.286 [0.113, 0.495]         0.05       0.15 Repurpose                aHUS           0.243        Same complement C5 target different disease\n"
     ]
    }
   ],
   "source": [
    "# Phase-dependent thresholds\n",
    "PHASE_THRESHOLDS = {\n",
    "    'Phase I':   {'kill': 0.05, 'go': 0.15},\n",
    "    'Phase II':  {'kill': 0.10, 'go': 0.25},\n",
    "    'Phase III': {'kill': 0.15, 'go': 0.40},\n",
    "}\n",
    "\n",
    "phases = df['phase'].tolist()\n",
    "\n",
    "def smart_decision(assets, phases, mean, lo, hi, repurpose_map, thresh_scale=1.0):\n",
    "    \"\"\"CI-based decisions with phase-dependent thresholds and biology-driven repurposing.\n",
    "\n",
    "    thresh_scale multiplies all thresholds (for interactive slider).\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    for i, asset in enumerate(assets):\n",
    "        phase = phases[i]\n",
    "        kill_t = PHASE_THRESHOLDS[phase]['kill'] * thresh_scale\n",
    "        go_t = PHASE_THRESHOLDS[phase]['go'] * thresh_scale\n",
    "\n",
    "        # Safety Bonus (1.4x) for repurposed assets\n",
    "        SAFETY_BONUS = 1.4\n",
    "\n",
    "        candidates = repurpose_map[repurpose_map['asset'] == asset].copy()\n",
    "        best_candidate = None\n",
    "        if len(candidates) > 0:\n",
    "            candidates = candidates.copy()\n",
    "            candidates['repurpose_pots'] = np.minimum(0.95, mean[i] * candidates['similarity_score'] * SAFETY_BONUS)\n",
    "            best_candidate = candidates.loc[candidates['repurpose_pots'].idxmax()]\n",
    "\n",
    "        if lo[i] > go_t:\n",
    "            dec = 'Go'\n",
    "            alt_ind = '-'\n",
    "            alt_pots = None\n",
    "            reason = '-'\n",
    "        elif hi[i] < kill_t:\n",
    "            if best_candidate is not None and best_candidate['repurpose_pots'] > mean[i] * 1.2:\n",
    "                dec = 'Repurpose'\n",
    "                alt_ind = best_candidate['alt_indication']\n",
    "                alt_pots = best_candidate['repurpose_pots']\n",
    "                reason = best_candidate['reason']\n",
    "            else:\n",
    "                dec = 'Kill'\n",
    "                alt_ind = '-'\n",
    "                alt_pots = None\n",
    "                reason = '-'\n",
    "        else:\n",
    "            # Uncertain zone or potential for better repurposing\n",
    "            if best_candidate is not None and best_candidate['repurpose_pots'] > mean[i]:\n",
    "                dec = 'Repurpose'\n",
    "                alt_ind = best_candidate['alt_indication']\n",
    "                alt_pots = best_candidate['repurpose_pots']\n",
    "                reason = best_candidate['reason']\n",
    "            else:\n",
    "                dec = 'Repurpose'\n",
    "                if best_candidate is not None:\n",
    "                    alt_ind = best_candidate['alt_indication']\n",
    "                    alt_pots = best_candidate['repurpose_pots']\n",
    "                    reason = best_candidate['reason']\n",
    "                else:\n",
    "                    alt_ind = 'No candidate'\n",
    "                    alt_pots = None\n",
    "                    reason = '-'\n",
    "\n",
    "        results.append({\n",
    "            'Asset': asset,\n",
    "            'Phase': phase,\n",
    "            'Current Indication': indications[i],\n",
    "            'PoTS (current)': round(mean[i], 3),\n",
    "            '90% CI': f'[{lo[i]:.3f}, {hi[i]:.3f}]',\n",
    "            'Kill thresh': round(kill_t, 3),\n",
    "            'Go thresh': round(go_t, 3),\n",
    "            'Decision': dec,\n",
    "            'Suggested Repurpose': alt_ind,\n",
    "            'Repurpose PoTS': round(alt_pots, 3) if alt_pots else '-',\n",
    "            'Reason': reason\n",
    "        })\n",
    })\n    return pd.DataFrame(results)\n"
    "\n",
    "decision_df = smart_decision(assets, phases, mean1, lo1, hi1, repurpose_map)\n",
    "print(decision_df.to_string(index=False))"
   ]
  },
