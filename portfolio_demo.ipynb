      "Asset C              NAFLD              0.60 Beta-cell stress and hepatic lipid metabolism overlap\n",
      "Asset C    Obesity (GLP-1)              0.70                         Direct GLP-1 receptor agonism\n",
      "Asset D    Type 2 Diabetes              0.60                         Liver-pancreas metabolic axis\n",
      "Asset D      NASH Fibrosis              0.80      Same hepatic lipid target with fibrotic endpoint\n",
      "Asset E               aHUS              0.85           Same complement C5 target different disease\n",
      "Asset E  Myasthenia Gravis              0.50                        Complement-mediated autoimmune\n"
     ]
    }
   ],
   "source": [
    "df = pd.read_csv('data/assets.csv')\n",
    "repurpose_map = pd.read_csv('data/repurpose_map.csv')\n",
    "\n",
    "assets = df['asset'].tolist()\n",
    "n = len(assets)\n",
    "indications = df['indication'].tolist()\n",
    "pathways = df['target_pathway'].tolist()\n",
    "alpha_prior = df['prior_successes'].values + 1.0\n",
    "beta_prior = df['prior_failures'].values + 1.0\n",
    "revenue = df['estimated_revenue_m'].values.astype(float)\n",
    "cost = df['estimated_cost_m'].values.astype(float)\n",
    "\n",
    "# Build correlation matrix from groups\n",
    "groups = df['correlation_group'].values\n",
    "correlation = np.eye(n)\n",
    "for i in range(n):\n",
    "    for j in range(i+1, n):\n",
    "        if groups[i] == groups[j]:\n",
    "            correlation[i, j] = correlation[j, i] = 0.6\n",
    "        else:\n",
    "            correlation[i, j] = correlation[j, i] = 0.15\n",
    "\n",
    "print(df[['asset', 'phase', 'indication', 'target_pathway', 'estimated_revenue_m', 'estimated_cost_m']].to_string(index=False))\n",
    "print('\\nCorrelation matrix:')\n",
    "print(pd.DataFrame(correlation, index=assets, columns=assets).to_string())\n",
    "print('\\nRepurpose candidates:')\n",
    "print(repurpose_map.to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2) Bayesian PoTS with Credible Intervals"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Asset      Indication     Phase  PoTS Mean  90% CI Lo  90% CI Hi\n",
      "Asset A             SLE  Phase II   0.250000   0.078820   0.470087\n",
      "Asset B Lupus Nephritis  Phase II   0.333333   0.135075   0.564374\n",
      "Asset C Type 2 Diabetes   Phase I   0.166667   0.033319   0.364359\n",
      "Asset D           NAFLD Phase III   0.416667   0.199576   0.650188\n",
      "Asset E Rare Haem (PNH)   Phase I   0.250000   0.078820   0.470087\n"
     ]
    }
   ],
   "source": [
    "def compute_pots(alpha, beta_param, ci=0.90):\n",
    "    \"\"\"Posterior mean and credible interval for each asset.\"\"\"\n",
    "    tail = (1 - ci) / 2\n",
    "    mean = beta.mean(alpha, beta_param)\n",
    "    lo = beta.ppf(tail, alpha, beta_param)\n",
    "    hi = beta.ppf(1 - tail, alpha, beta_param)\n",
    "    return mean, lo, hi\n",
    "\n",
    "mean0, lo0, hi0 = compute_pots(alpha_prior, beta_prior)\n",
    "\n",
    "prior_df = pd.DataFrame({\n",
    "    'Asset': assets, 'Indication': indications, 'Phase': df['phase'],\n",
    "    'PoTS Mean': mean0, '90% CI Lo': lo0, '90% CI Hi': hi0\n",
    "})\n",
    "print(prior_df.to_string(index=False))"
   ]
  },
