      "  Asset      Indication     PoTS  Revenue ($M)  Cost ($M)  eNPV ($M) Funded\n",
      "Asset D           NAFLD 0.333333         900.0       80.0      220.0    Yes\n",
      "Asset B Lupus Nephritis 0.375000         650.0      100.0      143.8    Yes\n",
      "Asset A             SLE 0.266667         800.0      120.0       93.3    Yes\n",
      "Asset E Rare Haem (PNH) 0.285714         500.0      150.0       -7.1     No\n",
      "Asset C Type 2 Diabetes 0.142857        1200.0      200.0      -28.6     No\n"
     ]
    }
   ],
   "source": [
    "def capital_allocation(pots_mean, revenue, cost, budget):\n",
    "    enpv = pots_mean * revenue - cost\n",
    "    order = np.argsort(-enpv)\n",
    "    funded = np.zeros(len(pots_mean), dtype=bool)\n",
    "    remaining = budget\n",
    "    for idx in order:\n",
    "        if enpv[idx] > 0 and cost[idx] <= remaining:\n",
    "            funded[idx] = True\n",
    "            remaining -= cost[idx]\n",
    "    return enpv, funded, remaining\n",
    "\n",
    "budget = 350\n",
    "enpv, funded, remaining = capital_allocation(mean1, revenue, cost, budget)\n",
    "\n",
    "alloc_df = pd.DataFrame({\n",
    "    'Asset': assets, 'Indication': indications,\n",
    "    'PoTS': mean1, 'Revenue ($M)': revenue, 'Cost ($M)': cost,\n",
    "    'eNPV ($M)': enpv.round(1),\n",
    "    'Funded': ['Yes' if f else 'No' for f in funded]\n",
    "})\n",
    "print(f'Budget: ${budget}M | Remaining: ${remaining:.0f}M\\n')\n",
    "print(alloc_df.sort_values('eNPV ($M)', ascending=False).to_string(index=False))"
   ]
  },
