    "## 7) Monte Carlo Portfolio Simulation\n",
    "\n",
    "Sample from the joint posterior using a Gaussian copula to respect correlations. Shows portfolio-level outcome distributions, not just per-asset point estimates."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Portfolio value distribution (10,000 simulations):\n",
      "  Median:      $250M\n",
      "  Mean:        $416M\n",
      "  5th pctile:  $-650M\n",
      "  95th pctile: $1950M\n",
      "  P(positive): 61.1%\n"
     ]
    }
   ],
   "source": [
    "def monte_carlo_portfolio(alpha, beta_param, corr, revenue, cost, n_sims=10000):\n",
    "    \"\"\"Simulate portfolio outcomes via Gaussian copula.\"\"\"\n",
    "    n_assets = len(alpha)\n",
    "    L = cholesky(corr, lower=True)\n",
    "    z = np.random.randn(n_sims, n_assets)\n",
    "    corr_z = z @ L.T\n",
    "    u = norm.cdf(corr_z)  # correlated uniform marginals\n",
    "\n",
    "    # Transform to Beta-distributed PoTS\n",
    "    pots_samples = np.zeros_like(u)\n",
    "    for i in range(n_assets):\n",
    "        pots_samples[:, i] = beta.ppf(u[:, i], alpha[i], beta_param[i])\n",
    "\n",
    "    # Binary success per sim, then portfolio value\n",
    "    success = (np.random.rand(n_sims, n_assets) < pots_samples).astype(float)\n",
    "    portfolio_value = (success * revenue - cost).sum(axis=1)\n",
    "    return pots_samples, portfolio_value\n",
    "\n",
    "pots_samples, portfolio_value = monte_carlo_portfolio(\n",
    "    alpha_post, beta_post, correlation, revenue, cost\n",
    ")\n",
    "\n",
    "print(f'Portfolio value distribution (10,000 simulations):')\n",
    "print(f'  Median:      ${np.median(portfolio_value):.0f}M')\n",
    "print(f'  Mean:        ${portfolio_value.mean():.0f}M')\n",
    "print(f'  5th pctile:  ${np.percentile(portfolio_value, 5):.0f}M')\n",
    "print(f'  95th pctile: ${np.percentile(portfolio_value, 95):.0f}M')\n",
    "print(f'  P(positive): {(portfolio_value > 0).mean():.1%}')"
   ]
