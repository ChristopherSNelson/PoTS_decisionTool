   "source": [
    "## 4) Correlated Failure Propagation\n",
    "\n",
    "When an asset gets bad news, correlated assets absorb a fraction of that penalty via the correlation matrix. Shared biology means shared risk."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Event: Asset D (NAFLD) fails pivotal readout\n",
      "\n",
      "  Asset      Indication  PoTS Before  PoTS After     Delta  Corr to Asset D\n",
      "Asset A             SLE     0.266667    0.253968 -0.012698             0.15\n",
      "Asset B Lupus Nephritis     0.375000    0.358209 -0.016791             0.15\n",
      "Asset C Type 2 Diabetes     0.142857    0.117647 -0.025210             0.60\n",
      "Asset D           NAFLD     0.333333    0.250000 -0.083333             1.00\n",
      "Asset E Rare Haem (PNH)     0.285714    0.271186 -0.014528             0.15\n"
     ]
    }
   ],
   "source": [
    "def propagate_failure(failed_idx, penalty, alpha, beta_param, corr):\n",
    "    \"\"\"Propagate a failure event through the correlation matrix.\"\"\"\n",
    "    virtual_failures = corr[failed_idx] * penalty\n",
    "    return alpha.copy(), beta_param + virtual_failures\n",
    "\n",
    "# Asset D (Phase III NAFLD) fails pivotal readout\n",
    "failed_idx = 3\n",
    "penalty = 5\n",
    "\n",
    "alpha_prop, beta_prop = propagate_failure(failed_idx, penalty, alpha_post, beta_post, correlation)\n",
    "mean_prop, lo_prop, hi_prop = compute_pots(alpha_prop, beta_prop)\n",
    "\n",
    "prop_df = pd.DataFrame({\n",
    "    'Asset': assets, 'Indication': indications,\n",
    "    'PoTS Before': mean1, 'PoTS After': mean_prop,\n",
    "    'Delta': mean_prop - mean1,\n",
    "    f'Corr to {assets[failed_idx]}': correlation[failed_idx],\n",
    "})\n",
    "print(f\"Event: {assets[failed_idx]} ({indications[failed_idx]}) fails pivotal readout\\n\")\n",
    "print(prop_df.to_string(index=False))"
   ]
  },
  {
