    "# Decision dashboard with phase-dependent thresholds\n",
    "dec_colors = {'Go': '#2ecc71', 'Kill': '#e74c3c', 'Repurpose': '#f39c12'}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 6))\n",
    "x_pos = np.arange(n)\n",
    "\n",
    "# Current indication bars with CI error bars\n",
    "yerr = np.array([mean1 - lo1, hi1 - mean1])\n",
    "bar_colors = [dec_colors[d] for d in decision_df['Decision']]\n",
    "ax.bar(x_pos, mean1, color=bar_colors, edgecolor='white', linewidth=1.5,\n",
    "       yerr=yerr, capsize=5, error_kw={'color': 'grey', 'linewidth': 1.2})\n",
    "\n",
    "# Draw phase-specific threshold markers per asset\n",
    "for i in range(n):\n",
