   "source": [
    "## 3) Interim Trial Updates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Asset      Indication  Prior PoTS  Posterior PoTS         90% CI\n",
      "Asset A             SLE    0.250000        0.266667 [0.104, 0.466]\n",
      "Asset B Lupus Nephritis    0.333333        0.375000 [0.191, 0.577]\n",
      "Asset C Type 2 Diabetes    0.166667        0.142857 [0.028, 0.316]\n",
      "Asset D           NAFLD    0.416667        0.333333 [0.153, 0.540]\n",
      "Asset E Rare Haem (PNH)    0.250000        0.285714 [0.113, 0.495]\n"
     ]
    }
   ],
   "source": [
    "# Simulated interim outcomes: (successes, total_trials)\n",
    "interim = {\n",
    "    'Asset A': (9, 10),\n",
    "    'Asset B': (2, 4),\n",
    "    'Asset C': (0, 100),  # Strong failure -> Kill\n",
    "    'Asset D': (0, 3),\n",
    "    'Asset E': (1, 2),\n",
    "}\n",
    "\n",
    "alpha_post = alpha_prior.copy()\n",
    "beta_post = beta_prior.copy()\n",
    "for i, asset in enumerate(assets):\n",
    "    s, t = interim[asset]\n",
    "    alpha_post[i] += s\n",
    "    beta_post[i] += (t - s)\n",
    "\n",
    "mean1, lo1, hi1 = compute_pots(alpha_post, beta_post)\n",
    "\n",
    "post_df = pd.DataFrame({\n",
    "    'Asset': assets, 'Indication': indications,\n",
    "    'Prior PoTS': mean0, 'Posterior PoTS': mean1,\n",
    "    '90% CI': [f'[{l:.3f}, {h:.3f}]' for l, h in zip(lo1, hi1)]\n",
    "})\n",
    "print(post_df.to_string(index=False))"
   ]
  },
